{
  "name": "@privion-consent/react",
  "version": "0.1.0",
  "description": "React bindings for Privion Consent",
  "keywords": [
    "consent",
    "gdpr",
    "privacy",
    "react",
    "hooks",
    "components"
  ],
  "author": "Tobias Laufersweiler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dreher-Media/privion-consent.git",
    "directory": "packages/consent-react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
