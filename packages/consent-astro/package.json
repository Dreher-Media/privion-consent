{
  "name": "@privion-consent/astro",
  "version": "1.0.0",
  "description": "Astro components and helpers for Privion Consent",
  "keywords": [
    "consent",
    "gdpr",
    "privacy",
    "astro",
    "ssr"
  ],
  "author": "Tobias Laufersweiler",
  "license": "MIT",
  "homepage": "https://github.com/Dreher-Media/privion-consent#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dreher-Media/privion-consent.git",
    "directory": "packages/consent-astro"
  },
  "bugs": {
    "url": "https://github.com/Dreher-Media/privion-consent/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./boot": {
      "import": "./dist/boot.js",
      "types": "./dist/boot.d.ts"
    },
    "./PrivionScript.astro": "./dist/PrivionScript.astro",
    "./ConsentBanner.astro": "./dist/ConsentBanner.astro",
    "./ConsentPreferences.astro": "./dist/ConsentPreferences.astro",
    "./CategoryToggle.astro": "./dist/CategoryToggle.astro"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && cp src/*.astro dist/",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  },
  "dependencies": {
    "@privion-consent/core": "workspace:*",
    "@privion-consent/dom": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/ui": "^1.0.0",
    "astro": "^4.16.0",
    "jsdom": "^23.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^1.0.0"
  }
}
