---
/**
 * Single category toggle row.
 *
 * Required categories render as a disabled, force-checked switch
 * carrying `privion-required="<id>"`. Optional categories render as
 * a switch carrying `privion-toggle="<id>"` so the DOM adapter
 * picks them up and routes changes through `setMany(_, 'preferences')`
 * when the user clicks Save.
 *
 * The `checked` attribute on optional toggles is set from
 * `category.defaultStatus`; the DOM adapter overwrites it on `ready`
 * with the actual stored state, so SSR doesn't have to know the
 * runtime value.
 */
import type { ConsentCategoryConfig } from '@privion-consent/core';

export interface Props {
  category: ConsentCategoryConfig;
  alwaysOnLabel?: string;
}

const { category, alwaysOnLabel = 'always on' } = Astro.props;
const optionalChecked = category.defaultStatus === 'granted';
---

<label privion-category>
  <span privion-category-text>
    <span privion-category-label>
      {category.label}
      {category.required && <span privion-category-badge>{alwaysOnLabel}</span>}
    </span>
    {
      category.description && (
        <span privion-category-description>{category.description}</span>
      )
    }
  </span>
  {
    category.required ? (
      <input type="checkbox" role="switch" checked disabled privion-required={category.id} />
    ) : (
      <input
        type="checkbox"
        role="switch"
        checked={optionalChecked}
        privion-toggle={category.id}
      />
    )
  }
</label>
