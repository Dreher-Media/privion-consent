{
  "name": "@privion-consent/dom",
  "version": "1.0.1",
  "description": "DOM adapter for Privion Consent - handles scripts, iframes, and element visibility",
  "keywords": [
    "consent",
    "gdpr",
    "privacy",
    "dom",
    "scripts",
    "iframes"
  ],
  "author": "Tobias Laufersweiler",
  "license": "MIT",
  "homepage": "https://github.com/Dreher-Media/privion-consent#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dreher-Media/privion-consent.git",
    "directory": "packages/consent-dom"
  },
  "bugs": {
    "url": "https://github.com/Dreher-Media/privion-consent/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && cp src/styles.css dist/",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@privion-consent/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/ui": "^1.0.0",
    "jsdom": "^23.0.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^1.0.0"
  }
}
