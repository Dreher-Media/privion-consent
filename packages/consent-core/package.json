  "description": "Core consent management engine for Privion Consent",
  "keywords": [
    "consent",
    "gdpr",
    "privacy",
    "cookies",
    "google-consent-mode"
  ],
  "author": "Tobias Laufersweiler",
  "license": "MIT",
  "homepage": "https://github.com/Dreher-Media/privion-consent#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dreher-Media/privion-consent.git",
    "directory": "packages/consent-core"
  },
  "bugs": {
    "url": "https://github.com/Dreher-Media/privion-consent/issues"
  },
  "type": "module",
  "sideEffects": false,
